# Example environment variables
# Copy this to .env and update with your values

DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Local SQLite is used unless DATABASE_URL exists or USE_POSTGRES=True.
USE_POSTGRES=False

# Render/hosted PostgreSQL usually provides this automatically.
# DATABASE_URL=postgresql://user:password@host:5432/smartpoultry?sslmode=require

# Local PostgreSQL settings, used when USE_POSTGRES=True.
DB_NAME=smartpoultry
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
# DB_SSLMODE=require

# ML Models
ML_MODEL_DIR=ml_models

# Email Configuration (Optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Production Settings (Uncomment for production)
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
