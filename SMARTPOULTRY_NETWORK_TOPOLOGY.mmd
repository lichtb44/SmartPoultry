        Auth["Authentication and User Sessions"]
        ML["ML Models<br/>Prediction utilities"]
    end

    subgraph Data["Data Layer"]
        DB[("SQLite Database<br/>db.sqlite3")]
        Backup[("Database Backup<br/>db.sqlite3.bak")]
    end

    subgraph External["Optional External Services"]
