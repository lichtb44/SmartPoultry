flowchart LR
    subgraph Users["Users and Client Devices"]
        Farmer["Farm Owner / User<br/>Laptop, tablet, or phone"]
        Admin["Administrator<br/>Laptop or desktop"]
    end

    Internet["Internet / Local Network"]
    Firewall["Router / Firewall"]

    subgraph Server["SMARTPOULTRY Application Server"]
        Web["Django Web Application<br/>HTTP service on port 8000"]
